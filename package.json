{
  "name": "healthcare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "// Frontend (Next.js)": "",
    "dev:next": "next dev",
    "build:next": "prisma generate && next build",
    "start:next": "next start",
    "// Backend (Express)": "",
    "dev:api": "nodemon --watch src/server --exec tsx src/server.ts",
    "build:api": "tsc --project tsconfig.server.json",
    "start:api": "node dist/server.js",
    "// Both servers": "",
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:api\"",
    "build": "npm run build:next && npm run build:api",
    "start": "concurrently \"npm run start:next\" \"npm run start:api\"",
    "// Database": "",
    "db:generate": "prisma generate --schema=./src/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./src/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=./src/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./src/db/prisma/schema.prisma",
    "db:seed": "prisma db seed tsx src/db/prisma/seed.ts",
    "db:reset": "prisma migrate reset --schema=./src/db/prisma/schema.prisma",
    "// Setup": "",
    "setup": "npm run db:generate && npm run db:push",
    "setup:db": "ts-node scripts/setup-database.ts",
    "setup:chromadb": "ts-node scripts/setup-chromadb.ts",
    "// Testing": "",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --watch --config jest.config.cjs",
    "test:coverage": "jest --coverage --config jest.config.cjs",
    "test:unit": "jest tests/unit --config jest.config.cjs",
    "test:integration": "jest tests/integration --config jest.config.cjs",
    "test:e2e": "jest tests/e2e --config jest.config.cjs",
    "// Docker": "",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:down:dev": "docker-compose -f docker-compose.dev.yml down",
    "docker:logs": "docker-compose logs -f",
    "docker:shell": "docker-compose exec app sh",
    "docker:seed": "docker-compose exec app npm run db:seed",
    "// Utilities": "",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.8",
