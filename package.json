    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "chromadb": "^3.0.17",
    "chromadb-default-embed": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
